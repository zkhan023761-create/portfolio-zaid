block variables 
- const title = "Zaid Khan — AI & DS Student / Full-Stack Developer"
- const description = "AI & Data Science Student / Full-Stack Developer from Mumbai, India. B.Voc in AI & Data Science at Nexcore NIT."
- const image = "/images/preview.jpg"
- const site = "@zaidkhan"


doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    base(href="/")

    title #{title}

    meta(name="description" content="AI & Data Science Student / Full-Stack Developer from Mumbai, India. B.Voc in AI & Data Science at Nexcore NIT.")

    link(rel="icon" type="image/svg+xml" href="/favicon.svg?v=2026")
    link(rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2026")
    link(rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2026")
    link(rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png?v=2026")
    link(rel="icon" type="image/x-icon" href="/favicon.ico?v=2026")
    link(rel="shortcut icon" href="/favicon.ico?v=2026")
    link(rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2026")
    link(rel="manifest" href="/site.webmanifest?v=2026" crossorigin="use-credentials")
    link(rel="mask-icon" href="/safari-pinned-tab.svg?v=2026" color="#2563EB")
    meta(name="msapplication-TileColor" content="#000000")
    meta(name="theme-color" content="#101416")

    meta(property="og:type" content="website")
    meta(property="og:title" content=title)
    meta(property="og:description" content=description)
    meta(property="og:image" content=image ? image: "")

    meta(property="twitter:card" content="summary_large_image")
    meta(property="twitter:title" content=title)
    meta(property="twitter:description" content=description)
    meta(property="twitter:image" content=image ? image: "")
    meta(property="twitter:site" content=site)

    link(href="https://api.fontshare.com/v2/css?f[]=clash-display@1&display=swap" rel="stylesheet")
    link(href="https://fonts.cdnfonts.com/css/manuscribe-free" rel="stylesheet")

  body(data-template=template)
    style
      include ../public/main.css

    include ./partials/preloader
    include ./partials/header
    include ./partials/navigation

    .content#content(data-template=template)
      block content

      if template === "home" || template === "about" || template === "contact"
        include ./partials/footer
    script.
      window.preloadables = !{JSON.stringify(preloadables).replace(/<\//g, "<\\/")}
    script(src="main.js?v=2026d") 
