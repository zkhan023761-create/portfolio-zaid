extends ../base.pug 

block variables
  - var template = "contact"

block content 
  main.contact
    .contact__wrapper 

      section.contact__heading
        .contact__heading__wrapper 
          h1.contact__heading__text(data-bigTitle)
            span.contact__heading__serif(data-alt="Say") Say
            span.contact__heading__sans(data-alt="Hi") Hi

      section.contact__body 
        address.contact__credits 
          ul.contact__credits__wrapper 
            li.contact__credit 
              p.contact__credit__task Inspired By:
              a.contact__credit__link(href="https://huyml.co" target="_blank" rel="noopener noreferrer") Huy Phan

            li.contact__credit 
              p.contact__credit__task Designed &amp; Built:
              a.contact__credit__link(href="https://www.linkedin.com/in/zaid-khan-943376379" target="_blank" rel="noopener noreferrer") Zaid Khan

        .contact__details 
          ul.contact__details__wrapper 
            li.contact__detail 
              p.contact__detail__type LinkedIn
              a.contact__detail__link(href="https://www.linkedin.com/in/zaid-khan-943376379" target="_blank" rel="noopener noreferrer") /in/zaid-khan

            li.contact__detail 
              p.contact__detail__type Github
              a.contact__detail__link(href="https://github.com/zkhan023761-create" target="_blank" rel="noopener noreferrer") /zkhan023761-create

            li.contact__detail 
              p.contact__detail__type Figma
              a.contact__detail__link(href="https://www.figma.com/design/xVgaR3muKlLBEf0DTcGfnq/Portfolio-Project?node-id=0-1&p=f&t=4HsgolleAXIYOzSp-0" target="_blank" rel="noopener noreferrer") Figma Showcase

            li.contact__detail 
              p.contact__detail__type Gmail
              a.contact__detail__link(href="mailto:zkhan023761@gmail.com") zkhan023761@gmail.com

        section.contact__canvas     
          .contact__canvas__wrapper    
            figure.contact__canvas__illustration
