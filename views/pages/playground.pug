            // 04. Figma Design System
            li.playground__project(data-color="#593d3c11")
              a.playground__project__description(href="https://www.figma.com/design/xVgaR3muKlLBEf0DTcGfnq/Portfolio-Project?node-id=0-1&p=f&t=4HsgolleAXIYOzSp-0" target="_blank" rel="noopener noreferrer") 
                p.playground__project__title Figma Design System
                p.playground__project__details 
                  | High-fidelity UI/UX design tokens, interactive prototyping, and component architectures published on Figma &amp; GitHub.
                p.playground__project__stack 
                  span Figma
