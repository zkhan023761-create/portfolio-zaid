          p.playground__heading__subtext(data-subTitle)
            | Live production platforms, healthcare AI collaborations, and Figma design architectures

      section.playground__body(data-color="#eaecee11")
        .playground__projects 
          ul.playground__projects__wrapper 
            // 01. Zuniii Creation
            li.playground__project(data-color="#ffca0811")
              a.playground__project__description(href="https://zunicreation.xyz" target="_blank" rel="noopener noreferrer") 
                p.playground__project__title Zuniii Creation
                p.playground__project__details 
                  | Live Luxury Bridal &amp; Contemporary Mehndi Platform in Mumbai with automated WhatsApp client booking pipeline.
                p.playground__project__stack 
                  span Next.js
                  span PM2 Daemons
                  span WhatsApp API
                .playground__project__action 
                  .playground__action__wrapper 
                    svg.playground__action__icon(width="24" height="24" viewBox="0 0 24 24" fill="none")
                      path(d=live_d fill="black") 
                    p.playground__action__text Live
              .playground__project__medias 
                figure.playground__project__media 
                  img.playground__project__image(src="images/zunicreation-home.png" alt="Zuniii Creation preview" data-delay="0.1") 

            // 02. RescueBite
            li.playground__project(data-color="#0080ff11")
              a.playground__project__description(href="https://rescuebiteofficial.vercel.app/" target="_blank" rel="noopener noreferrer") 
                p.playground__project__title RescueBite
                p.playground__project__details 
                  | Real-time food surplus redistribution routing platform connecting restaurants, donors, and volunteers to minimize waste.
                p.playground__project__stack 
                  span React
                  span Logistics UX
                  span Vercel
                .playground__project__action 
                  .playground__action__wrapper 
                    svg.playground__action__icon(width="24" height="24" viewBox="0 0 24 24" fill="none")
                      path(d=live_d fill="black") 
                    p.playground__action__text Live
              .playground__project__medias 
                figure.playground__project__media 
                  img.playground__project__image(src="images/rescuebite-home.png" alt="RescueBite preview" data-delay="0.1") 

            // 03. Medi AI
            li.playground__project(data-color="#aaffd511")
              a.playground__project__description(href="https://medi-ai-official.vercel.app/" target="_blank" rel="noopener noreferrer") 
                p.playground__project__title Medi AI
                p.playground__project__details 
                  | Clinical intelligence and triage assistance platform delivering diagnostic insights and connected medical workflows.
                p.playground__project__stack 
                  span Next.js
                  span Healthcare AI
                  span PM2
                .playground__project__action 
                  .playground__action__wrapper 
                    svg.playground__action__icon(width="24" height="24" viewBox="0 0 24 24" fill="none")
